# Firebase client config (safe to expose in the app bundle).
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration.
#
# Access is controlled by Firestore/Storage security rules (public read,
# admin-only write), so these identifiers do not need to be secret.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
